# Enforce LF endings for all text files
* text eol=lf

# Keep Windows-specific scripts with CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Treat common binary assets as binary (no EOL normalization)
*.png binary
# Гліфи підписів карти (PBF) — двійкові; без цього рядка git «виправляв» у них переноси (закон §9 v1.78)
*.pbf binary
*.jpg binary
*.jpeg binary
*.gif binary
*.svg binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.mp4 binary
