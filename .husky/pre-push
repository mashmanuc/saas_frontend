#!/bin/sh
# Phase 4 pre-push — DUMB GREP enforcement.
#
# Правила:
#   - кожна зона має простий grep
#   - якщо grep returns hits → exit 1
#   - ignore: comment lines, /tests/, /__tests__/, .spec., /archive/, /migrations/
#   - explicit override: коментар-маркер `# noqa: INV-8` на тій самій лінії
#   - НЕ smart filter, НЕ heuristic, НЕ grandfathering
#
# Reference:
#   - saas_docs/domains/winterboard/ops_sync/SYSTEM_LAW.md §12
#   - saas_docs/domains/winterboard/ops_sync/RECONSTRUCTION_PLAN.md Phase 4
#
# Husky може бути обійдено `git push --no-verify` — same checks live у
# `.github/workflows/invariants.yml` (CI, non-bypassable).

set +e

echo "🔒 Phase 4 pre-push (dumb grep enforcement)"

GIT_TOPLEVEL="$(git rev-parse --show-toplevel)"
REPO_ROOT="$(dirname "$GIT_TOPLEVEL")"
cd "$REPO_ROOT" || exit 1

FAIL=0

# Common ignore-paths grep -v args.
IGNORE_PATHS='/tests/\|/__tests__/\|\.spec\.\|\.test\.\|/archive/\|/migrations/'
# Comment lines (Python `#`, JS `//`, `/* */`, `*` continuation).
IGNORE_COMMENTS_PY='^[^:]*:[0-9]*:[[:space:]]*#'
IGNORE_COMMENTS_JS='^[^:]*:[0-9]*:[[:space:]]*\(//\|\*\|/\*\)'
# Explicit override marker.
IGNORE_NOQA='# noqa: INV-8'

# ── INV-7 SERVICE-ENTRYPOINT ────────────────────────────────────────────
# WBBoardOperation.objects.(create|bulk_create|update) outside OpsApplyService.
echo ""
echo "🔍 INV-7 SERVICE-ENTRYPOINT"
HITS=$(grep -rEn 'WBBoardOperation\.objects\.(create|bulk_create|update)\s*\(' \
  backend/apps/winterboard --include='*.py' 2>/dev/null \
  | grep -v "ops_apply_service\.py\|$IGNORE_PATHS\|/management/commands/" \
  | grep -v "$IGNORE_COMMENTS_PY")
if [ -n "$HITS" ]; then
  echo "❌ INV-7 violated:"
  echo "$HITS"
  echo "   Fix: route through OpsApplyService.apply()"
  FAIL=1
else
  echo "✅ INV-7 OK"
fi

# ── INV-8 NO-BYPASS ─────────────────────────────────────────────────────
# Direct `session.state =` mutation. Override via `# noqa: INV-8` on same line.
echo ""
echo "🔍 INV-8 NO-BYPASS (state= assignment)"
HITS=$(grep -rEn '\b(session|wb_session|new_session)\.state\s*=' \
  backend/apps/winterboard --include='*.py' 2>/dev/null \
  | grep -v "ops_apply_service\.py\|$IGNORE_PATHS" \
  | grep -v "$IGNORE_COMMENTS_PY" \
  | grep -v "$IGNORE_NOQA")
if [ -n "$HITS" ]; then
  echo "❌ INV-8 violated:"
  echo "$HITS"
  echo "   Fix: use OpsApplyService OR add explicit `# noqa: INV-8 (<reason>)` if legitimate bypass writer"
  FAIL=1
else
  echo "✅ INV-8 OK"
fi

# ── INV-9 QUERYSET-BYPASS ───────────────────────────────────────────────
# WBSession.objects.update(state=...) bypasses save() guard.
echo ""
echo "🔍 INV-9 QUERYSET-BYPASS"
HITS=$(grep -rEn 'WBSession\.objects\.(filter\([^)]*\)\.)?update\([^)]*(state|last_op_seq)\s*=' \
  backend/apps/winterboard --include='*.py' 2>/dev/null \
  | grep -v "$IGNORE_PATHS" \
  | grep -v "$IGNORE_COMMENTS_PY")
if [ -n "$HITS" ]; then
  echo "❌ INV-9 violated:"
  echo "$HITS"
  echo "   Fix: queryset.update() bypasses save() guard — use OpsApplyService"
  FAIL=1
else
  echo "✅ INV-9 OK"
fi

# ── LAW §12 FE — PR3 hacks ──────────────────────────────────────────────
echo ""
echo "🔍 LAW §12 FE forbidden constants"
HITS=$(grep -rEn 'MAX_LOCK_RETRIES|consecutive409|MAX_409_PER_SESSION|PAUSE_AFTER_CONSECUTIVE|lockRetryCount' \
  frontend/src --include='*.ts' --include='*.tsx' --include='*.js' --include='*.vue' 2>/dev/null \
  | grep -v "$IGNORE_PATHS" \
  | grep -v "$IGNORE_COMMENTS_JS")
if [ -n "$HITS" ]; then
  echo "❌ LAW §12 violated (PR3 hacks):"
  echo "$HITS"
  echo "   Fix: remove all references; PR3 deprecated 2026-04-26"
  FAIL=1
else
  echo "✅ LAW §12 FE OK"
fi

# ── LAW §12 BE — silent suppression ─────────────────────────────────────
echo ""
echo "🔍 LAW §12 BE silent error suppression"
HITS=$(grep -rEn '^[[:space:]]*except[^:]*:[[:space:]]*pass[[:space:]]*$' \
  backend/apps/winterboard backend/apps/users/api 2>/dev/null \
  | grep -v "$IGNORE_PATHS")
if [ -n "$HITS" ]; then
  echo "❌ LAW §12 silent-suppression violated:"
  echo "$HITS"
  echo "   Fix: log + re-raise OR explicit handle"
  FAIL=1
else
  echo "✅ LAW §12 BE OK"
fi

# ── SUPPRESS — @ts-ignore (any), file-level /* eslint-disable */ ────────
# Per-line `eslint-disable-next-line <rule>` ALLOWED (pragmatic).
echo ""
echo "🔍 SUPPRESS strict (@ts-ignore, file-level /* eslint-disable */)"
HITS=$(grep -rEn '@ts-ignore|/\*[[:space:]]*eslint-disable[[:space:]]*\*/' \
  frontend/src --include='*.ts' --include='*.tsx' --include='*.js' --include='*.vue' 2>/dev/null \
  | grep -v "$IGNORE_PATHS")
if [ -n "$HITS" ]; then
  echo "❌ SUPPRESS strict violated:"
  echo "$HITS"
  echo "   Fix: @ts-ignore → @ts-expect-error з explanation; file-level eslint-disable → disable specific rules"
  FAIL=1
else
  echo "✅ SUPPRESS OK"
fi

# ── Anti-regression: deleted endpoints stay deleted ─────────────────────
echo ""
echo "🔍 Legacy endpoints stay deleted"
HITS=$(grep -En "'/diff/'|'/save-stream/'|'/beacon/'|/replay/operation/" \
  backend/apps/winterboard/urls.py 2>/dev/null \
  | grep -v "^[^:]*:[0-9]*:[[:space:]]*#")
if [ -n "$HITS" ]; then
  echo "❌ Legacy endpoint resurrected у urls.py:"
  echo "$HITS"
  echo "   PR-B (commit 5db76e5) + Phase 4 follow-up DELETED these."
  FAIL=1
else
  echo "✅ Legacy endpoints stay deleted"
fi

# NOTE: pnpm lint + pnpm typecheck НЕ виконуються тут — це slow checks
# (vue-tsc full pass = 30+s), і вони мають pre-existing tech-debt failures
# вне scope Phase 4 enforcement. Замість цього вони running у CI workflow
# (non-bypassable). Husky тут — fast SSOT grep filter (<5s).
# Reference: DEV_QUALITY_GATES.md "Husky <10s" rule.

# ── Final ───────────────────────────────────────────────────────────────
echo ""
if [ "$FAIL" = "1" ]; then
  echo "❌ pre-push BLOCKED — fix violations above"
  exit 1
fi
echo "✅ pre-push gate passed"
