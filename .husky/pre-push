#!/bin/sh
# Husky calls hooks через `sh -e`. Disable errexit — гак explicitly uses `|| exit 1`
# для блокуючих умов; intermediate grep returns exit 1 при no-match (legitimate)
# і це НЕ означає що hook повинен fail.
set +e

# PRE-PUSH GATE — Phase 0.5 temporary hook
# До Phase 4 повного DEV_QUALITY_GATES rollout цей файл забезпечує мінімальний enforcement.
# Після Phase 4 → переїде у `.github/workflows/ssot-gates.yml` (non-bypassable).
#
# Reference: saas_docs/domains/winterboard/ops_sync/SYSTEM_LAW.md Section 12 + Section 13
#
# ENFORCEMENT MODES:
#   - LEGACY_MODE=warn  (default zараз) — existing violations показуються як ⚠️, не блокують push
#   - LEGACY_MODE=block (after Phase 3 cleanup) — будь-яка violation = exit 1
#
#   - NEW_MODE=block (default zавжди) — нові violations у diff vs origin/master = exit 1
#
# Tо switch to full strict mode після Phase 3:
#   sed -i 's/LEGACY_MODE=warn/LEGACY_MODE=block/' .husky/pre-push

LEGACY_MODE=warn
NEW_MODE=block

echo "🔒 SSOT pre-push gate (Phase 0.5 — Husky temp; Phase 4 → CI)"

# ─── Project root detection ──────────────────────────────────────────────
GIT_TOPLEVEL="$(git rev-parse --show-toplevel)"
REPO_ROOT="$(dirname "$GIT_TOPLEVEL")"
cd "$REPO_ROOT" || exit 1
echo "  (gate scope: $REPO_ROOT, legacy=$LEGACY_MODE, new=$NEW_MODE)"

# ─── Detect changed files vs origin (for NEW violations check) ───────────
# Якщо origin/master не існує (першeпуш) — пустий diff (всі файли як NEW).
CHANGED_FILES=$(git diff --name-only --diff-filter=AM origin/master..HEAD 2>/dev/null || \
                git diff --name-only HEAD 2>/dev/null || echo "")

is_new_file() {
  # $1 = file path. Returns 0 if changed у поточному push, 1 інакше.
  echo "$CHANGED_FILES" | grep -qF "$1"
}

# Helper: process violations — emit WARN or FAIL based on mode.
report_violations() {
  local invariant="$1"
  local violations="$2"
  local fix_hint="$3"

  if [ -z "$violations" ]; then
    echo "  ✅ $invariant"
    return 0
  fi

  # Розділяємо на NEW (changed in this push) vs LEGACY (pre-existing)
  local new_v=""
  local legacy_v=""
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    local file=$(echo "$line" | cut -d: -f1)
    if is_new_file "$file"; then
      new_v="$new_v$line\n"
    else
      legacy_v="$legacy_v$line\n"
    fi
  done <<EOF
$violations
EOF

  if [ -n "$new_v" ]; then
    echo "❌ $invariant — NEW VIOLATION (NEW_MODE=$NEW_MODE):"
    echo -e "$new_v"
    echo "  Fix: $fix_hint"
    [ "$NEW_MODE" = "block" ] && return 1
  fi
  if [ -n "$legacy_v" ]; then
    if [ "$LEGACY_MODE" = "block" ]; then
      echo "❌ $invariant — LEGACY VIOLATION (LEGACY_MODE=block):"
      echo -e "$legacy_v"
      echo "  Fix: $fix_hint"
      return 1
    else
      echo "  ⚠️  $invariant — $(echo -e "$legacy_v" | grep -c .) legacy violations (LEGACY_MODE=warn → not blocking)"
    fi
  fi
  return 0
}

# ─── INV-7 SERVICE-ENTRYPOINT (LAW §2): writes outside OpsApplyService ───
INV7=$(grep -rn \
  -e "WBSession\.objects\.create" \
  -e "WBSession\.objects\.update" \
  -e "WBBoardOperation\.objects\.create" \
  -e "WBBoardOperation\.objects\.bulk_create" \
  -e "WBBoardOperation\.objects\.update" \
  backend/apps/winterboard --include='*.py' 2>/dev/null \
  | grep -v "ops_apply_service\.py\|/tests/\|/management/commands/\|/migrations/")
report_violations "INV-7 SERVICE-ENTRYPOINT" "$INV7" "route through OpsApplyService" || exit 1

# ─── INV-8 NO-BYPASS (LAW §2): direct .state = mutation ─────────────────
INV8=$(grep -rn \
  -e "session\.state\s*=" \
  -e "wb_session\.state\s*=" \
  backend/apps/winterboard --include='*.py' 2>/dev/null \
  | grep -v "ops_apply_service\.py\|/tests/\|/migrations/" \
  | grep -v "^[^:]*:[0-9]*:[[:space:]]*#")
report_violations "INV-8 NO-BYPASS (state mutation)" "$INV8" "only OpsApplyService.apply() may mutate state" || exit 1

# ─── LAW §12 FORBIDDEN PATTERNS: legacy hacks (PR3 deprecated constants) ─
for pattern in "MAX_LOCK_RETRIES" "consecutive409" "MAX_409_PER_SESSION" "PAUSE_AFTER_CONSECUTIVE"; do
  HACK=$(grep -rn "$pattern" \
    frontend/src --include='*.ts' --include='*.js' --include='*.vue' 2>/dev/null \
    | grep -v "/__tests__/\|\.spec\.\|/archive/" \
    | grep -vE "^[^:]*:[0-9]+:[[:space:]]*(//|\*|/\*)")
  report_violations "LAW §12 forbidden ($pattern)" "$HACK" "remove; per Phase 3 plan ці constants заборонені" || exit 1
done

# ─── LAW §12: silent error suppression (Python only — JS empty catch не grep'aбельний просто) ─
SILENT_PY=$(grep -rn "except.*:[[:space:]]*pass[[:space:]]*$" \
  backend/apps/winterboard backend/apps/users/api 2>/dev/null \
  | grep -v "/tests/\|/migrations/")
report_violations "LAW §12 silent suppression" "$SILENT_PY" "handle explicitly або log + re-raise" || exit 1

echo "✅ SSOT pre-push gate passed"
