# API Configuration
VITE_API_BASE_URL=/api

# Canonical frontend origin — used in email verification links.
# In production, set to the main domain (e.g. https://m4sh.org).
# Prevents preview/staging domains from leaking into emails.
VITE_APP_ORIGIN=

# Debug Features
VITE_CALENDAR_DEBUG=false

# Other environment variables
# Add your configuration here

# Winterboard v4
VITE_WB_ENABLED=false
VITE_WB_USE_YJS=false
VITE_WB_WS_URL=ws://localhost:8000/ws/winterboard/

# Support link (saas_docs/plans/SUPPORT_CTA_PLAN_2026-05-27.md)
# Footer-only. Відкрити після launch: VITE_SUPPORT_ENABLED=true
VITE_SUPPORT_URL=https://send.monobank.ua/jar/68KPMcHzGy
VITE_SUPPORT_ENABLED=false

# Google OAuth (PR 2 — saas_docs/plans/GOOGLE_OAUTH_PLAN_2026-05-20.md)
# Той самий Client ID що у backend GOOGLE_OAUTH_CLIENT_ID env (audience JWT).
# Створюється у Google Cloud Console → APIs & Services → Credentials → OAuth Client ID (Web).
# Authorized JS origins: http://localhost:5173, http://localhost:8000, https://m4sh.org
# Якщо порожній — кнопка "Continue with Google" у LoginView НЕ показується (gate INV-OAUTH-S4).
VITE_GOOGLE_OAUTH_CLIENT_ID=
