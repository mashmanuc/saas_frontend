    {
     "q": "$1{,}2 + 0{,}03$",
     "a": "зрівнюємо: $1{,}20 + 0{,}03 = 1{,}23$"
    },
    {
     "q": "$17 - 0{,}1$",
     "a": "$17{,}0 - 0{,}1 = 16{,}9$ — ціле число теж має кому"
    }
   ]
  },
