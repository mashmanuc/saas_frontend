     "q": "$2x - 6 = -14$",
     "a": "мінус стає плюсом: $2x = -14 + 6 = -8$, тому $x = -4$"
    },
    {
     "q": "$3x - 15 = -57$",
     "a": "$3x = -57 + 15 = -42$, тому $x = -14$"
    }
   ]
  },
